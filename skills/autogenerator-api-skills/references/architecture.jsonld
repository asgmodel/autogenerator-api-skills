{
  "@context": {
    "@vocab": "https://github.com/asgmodel/autogenerator-api-skills#",
    "dependsOn": {
      "@type": "@id"
    },
    "uses": {
      "@type": "@id"
    },
    "generates": {
      "@type": "@id"
    },
    "requiresCheck": {
      "@type": "@id"
    },
    "lifetime": {
      "@type": "@id"
    },
    "reference": {
      "@type": "@id"
    }
  },
  "@id": "https://github.com/asgmodel/autogenerator-api-skills#Architecture",
  "@type": "ArchitectureOntology",
  "version": "1.4.0",
  "@graph": [
    {
      "@id": "#Inspect",
      "@type": "Stage",
      "reference": "references/generation.md#1-inspect-the-target-project"
    },
    {
      "@id": "#Model",
      "@type": "Artifact",
      "dependsOn": "#Inspect",
      "requiresCheck": [
        "#ModelContract",
        "#Build"
      ],
      "reference": "references/generation.md#2-select-or-create-itmodel-entities",
      "marker": "ITModel"
    },
    {
      "@id": "#Generator",
      "@type": "Component",
      "dependsOn": "#ModeSelection",
      "generates": "#BPR",
      "reference": "references/generation.md"
    },
    {
      "@id": "#BPR",
      "@type": "Artifact",
      "requiresCheck": [
        "#Contracts",
        "#Build"
      ],
      "reference": "references/generation.md#6-review-generated-files-and-organize-layers"
    },
    {
      "@id": "#Validator",
      "@type": "Artifact",
      "dependsOn": "#ScaffoldReview",
      "uses": "#ConditionChecker",
      "requiresCheck": [
        "#ConditionContract",
        "#ScopeIsolation",
        "#Build",
        "#ConditionDispatch"
      ],
      "reference": "references/validator-generation.md",
      "generates": "#ConditionState"
    },
    {
      "@id": "#ConditionChecker",
      "@type": "Component",
      "lifetime": "#Scoped",
      "uses": "#FactoryInjector",
      "requiresCheck": "#InjectorAssignment",
      "reference": "references/condition-checker.md"
    },
    {
      "@id": "#FactoryInjector",
      "@type": "Component",
      "lifetime": "#Scoped",
      "uses": "#DbContext"
    },
    {
      "@id": "#DbContext",
      "@type": "Component",
      "lifetime": "#Scoped"
    },
    {
      "@id": "#Procedure",
      "@type": "Artifact",
      "dependsOn": [
        "#BPR",
        "#Validator"
      ],
      "requiresCheck": [
        "#ProcedureContract",
        "#Build"
      ],
      "reference": "references/ai-generation.md#procedures-and-integration"
    },
    {
      "@id": "#Integration",
      "@type": "Stage",
      "dependsOn": [
        "#BPR",
        "#Validator"
      ],
      "requiresCheck": [
        "#Contracts",
        "#ScopeIsolation",
        "#Build",
        "#Behavior"
      ],
      "reference": "references/generation.md#7-complete-validators-and-integrate-layers"
    },
    {
      "@id": "#Singleton",
      "@type": "Lifetime",
      "marker": "ITSingleton",
      "rule": "Never capture scoped dependencies or request-specific mutable state."
    },
    {
      "@id": "#Scoped",
      "@type": "Lifetime",
      "marker": "ITScope",
      "rule": "Verify the actual scanner or explicit registration; one instance per scope."
    },
    {
      "@id": "#Transient",
      "@type": "Lifetime",
      "marker": "ITTransient"
    },
    {
      "@id": "#ModelContract",
      "@type": "Verification"
    },
    {
      "@id": "#Contracts",
      "@type": "Verification"
    },
    {
      "@id": "#ConditionContract",
      "@type": "Verification"
    },
    {
      "@id": "#ScopeIsolation",
      "@type": "Verification"
    },
    {
      "@id": "#InjectorAssignment",
      "@type": "Verification"
    },
    {
      "@id": "#ProcedureContract",
      "@type": "Verification"
    },
    {
      "@id": "#Build",
      "@type": "Verification"
    },
    {
      "@id": "#Behavior",
      "@type": "Verification"
    },
    {
      "@id": "#ConditionState",
      "@type": "Artifact",
      "uses": "#DataFilter",
      "generates": "#ConditionResult",
      "requiresCheck": [
        "#ConditionDispatch",
        "#FailClosed"
      ]
    },
    {
      "@id": "#DataFilter",
      "@type": "Contract",
      "reference": "references/condition-checker.md#value-and-model-resolution"
    },
    {
      "@id": "#ConditionResult",
      "@type": "Contract"
    },
    {
      "@id": "#ConditionDispatch",
      "@type": "Verification",
      "reference": "references/condition-checker.md#actual-execution"
    },
    {
      "@id": "#FailClosed",
      "@type": "Verification",
      "reference": "references/condition-checker.md#result-factories-and-consumers"
    },
    {
      "@id": "#LibrarySetup",
      "@type": "Stage",
      "dependsOn": "#Model",
      "reference": "references/generation.md#3-install-or-reuse-the-library"
    },
    {
      "@id": "#HostSetup",
      "@type": "Stage",
      "dependsOn": "#LibrarySetup",
      "uses": "#DbContext",
      "requiresCheck": "#Build",
      "reference": "references/generation.md#4-configure-dbcontext-and-programcs"
    },
    {
      "@id": "#ModeSelection",
      "@type": "Stage",
      "dependsOn": "#HostSetup",
      "reference": "references/generation.md#5-recommend-one-bpr-mode-and-hand-off-the-command"
    },
    {
      "@id": "#ScaffoldReview",
      "@type": "Stage",
      "dependsOn": "#Generator",
      "uses": "#BPR",
      "requiresCheck": [
        "#Contracts",
        "#Build"
      ],
      "reference": "references/generation.md#6-review-generated-files-and-organize-layers"
    },
    {
      "@id": "#CreateBackendExample",
      "@type": "UsageExample",
      "title": "توليد مشروع كامل",
      "prompt": "استخدم autogenerator-api-skills لإنشاء نظام إدارة المستشفيات من الصفر.",
      "uses": "#Integration",
      "scope": "Follow the complete generation procedure; recommend one BPR mode and command, complete applicable business conditions and verify."
    },
    {
      "@id": "#ExtendBackendExample",
      "@type": "UsageExample",
      "title": "تطوير مشروع موجود",
      "prompt": "استخدم autogenerator-api-skills لفحص مشروعي الحالي وتجهيز الموديلات باستخدام ITModel وتوليد الطبقات الناقصة.",
      "uses": [
        "#Model",
        "#ScaffoldReview"
      ],
      "scope": "Inspect existing host and models; add markers only to selected entities, reuse installed dependencies, generate missing layers and preserve custom code."
    },
    {
      "@id": "#GenerateValidatorsExample",
      "@type": "UsageExample",
      "title": "توليد Validators فقط",
      "prompt": "استخدم autogenerator-api-skills لتوليد Validators لجميع الموديلات المطلوبة وربط الشروط باستخدام IConditionChecker.",
      "uses": "#Validator",
      "scope": "Reuse existing scaffolding; generate only requested conditions and required integration. Do not regenerate unrelated layers."
    },
    {
      "@id": "#AddModelExample",
      "@type": "UsageExample",
      "title": "إضافة موديل جديد",
      "prompt": "استخدم autogenerator-api-skills لإضافة موديل Coupon وربطه بالطلبات وتوليد طبقات BPR والشروط اللازمة.",
      "uses": [
        "#Model",
        "#ScaffoldReview",
        "#Validator"
      ],
      "scope": "Extend relevant entity relationships and context; verify assembly discovery and preserve unrelated generated/custom files."
    },
    {
      "@id": "#AuditArchitectureExample",
      "@type": "UsageExample",
      "title": "فحص المعمارية وإصلاحها",
      "prompt": "استخدم autogenerator-api-skills لتحليل المعمارية الحالية وإصلاح أخطاء DI والـ Validators والـ Repositories والتحقق من البناء.",
      "uses": [
        "#ConditionChecker",
        "#BPR",
        "#Integration"
      ],
      "scope": "Diagnose actual host and first build/runtime failures; repair evidenced issues, preserve contracts and verify."
    }
  ],
  "installCommand": "npx skills add asgmodel/autogenerator-api-skills",
  "invocationRule": "Invoke the installed skill by name with the target project and desired outcome. Always inspect the target first. Match UsageExample intent by meaning, not exact wording. Treat uses links as relevant architecture targets, not mandatory execution lists. Resolve only applicable dependencies, reuse verified stages, preserve scope, and report actual evidence. This is an agent-readable reference, not an executable generator or task log."
}
